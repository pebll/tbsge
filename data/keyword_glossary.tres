[gd_resource type="Resource" script_class="KeywordGlossary" format=3]

[ext_resource type="Script" path="res://scripts/data/keyword_glossary.gd" id="1_glossary"]

[resource]
script = ExtResource("1_glossary")
entries = {
"terminal": {
"label": "Terminal",
"definition": "Ends this legion's turn after use. Remaining AP is spent."
},
"cooldown": {
"label": "Cooldown",
"definition": "Must wait a number of turns before this action can be used again."
},
"los": {
"label": "LOS",
"definition": "Line of sight. Mountains and some obstacles block ranged targeting."
},
"forest_cover": {
"label": "Forest cover",
"definition": "Forests can reduce incoming ranged effectiveness for units standing in them."
},
"ap": {
"label": "AP",
"definition": "Action points. Spent to move and use actions each turn."
},
"range": {
"label": "Range",
"definition": "How many hexes away a valid target can be."
},
"ally": {
"label": "Ally",
"definition": "A legion on your own team."
},
"tag_ranged": {
"label": "Ranged",
"definition": "Can attack from a distance. Melee-only units can't strike back at range 2."
},
"tag_support": {
"label": "Support",
"definition": "Helps allies or hinders enemies: heals, buffs or curses."
},
"tag_shielded": {
"label": "Shielded",
"definition": "Each unit's shield absorbs damage from the first hit it takes every turn."
},
"tag_armored": {
"label": "Armored",
"definition": "Lots of health per unit: hard to wear down."
},
"tag_swarm": {
"label": "Swarm",
"definition": "Many cheap units: spreads damage and hits many times."
},
"tag_striker": {
"label": "Striker",
"definition": "A damage dealer: hits hard for its cost."
},
"tag_mobile": {
"label": "Mobile",
"definition": "Covers ground fast: 3+ action points or teleport."
},
"tag_flyer": {
"label": "Flyer",
"definition": "Flies over water and mountains at 1 AP per hex and can land there; ignores slow terrain and cover."
},
"trait_regeneration": {
"label": "Regeneration",
"definition": "Each unit heals at the start of its own turn."
},
"trait_lifesteal": {
"label": "Lifesteal",
"definition": "Each unit heals half the HP its strikes take."
},
"trait_pierce": {
"label": "Pierce",
"definition": "Strikes ignore and break shields."
},
"trait_poison_on_hit": {
"label": "Poison strikes",
"definition": "Each landed strike adds a stack of Poison to the target."
},
"trait_flying": {
"label": "Flying",
"definition": "Flies over water and mountains at 1 AP per hex and can land there; ignores slow terrain and cover."
}
}
